{
  // Node-side code and the browser panel in one project: `src/webui/client.ts` is the only file with
  // DOM types, and one `tsc --noEmit` is what keeps it checked. `cortico/*` resolves through the
  // `node_modules/cortico` link that scripts/setup-dev.mjs creates, which points at the Coopanion
  // checkout's framework source; at run time the host's own module hook resolves the prefix.
  // vitest.config.ts maps the same files.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "cortico/*": ["./node_modules/cortico/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
