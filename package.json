{
  "name": "cortico-world-wvd",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: plays Wizardry Variants Daphne's FFXI dungeon route from a Windows child process",
  "keywords": [
    "cortico-world",
    "cortico",
    "wizardry-variants-daphne"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "setup:dev": "node scripts/setup-dev.mjs",
    "build": "node scripts/build-webui.mjs",
    "pretest": "node scripts/setup-dev.mjs",
    "pretypecheck": "node scripts/setup-dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "koffi": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
